{
  "region": "us-east-1",
  "table_name": "cs4360-alerts",
  "purpose": "Persistent storage for anomaly detection alerts",
  "partition_key": {
    "name": "alert_id",
    "type": "S"
  },
  "billing_mode": "PAY_PER_REQUEST",
  "attributes": [
    "alert_id",
    "dataset",
    "record_index",
    "anomaly_score",
    "model_prediction",
    "status",
    "actual_label",
    "attack_type"
  ],
  "access": {
    "public_access": false,
    "encryption": "AWS managed encryption"
  }
}
